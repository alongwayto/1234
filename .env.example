DB_USERNAME=root
DB_PASSWORD=
DB_URL=jdbc:mysql://127.0.0.1:3307/campus_equipment?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false
BACKUP_PATH=./backups/
MYSQL_DUMP_PATH=mysqldump
MYSQL_PATH=mysql

# ============ AI智能配置 ============
# 豆包API Key (必需) - 用于AI智能诊断和智能体聊天功能
# 获取地址: https://console.volcengine.com/ark
DOUBAO_API_KEY=

# AI模型配置 (可选，使用默认值)
# 可用模型: doubao-seed-2-0-pro-260215, doubao-seed-2-0-lite-260215, doubao-seed-2-0-mini-260215
AI_MODEL=doubao-seed-2-0-lite-260215
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2000

# AI诊断功能开关 (默认开启)
AI_DIAGNOSIS_ENABLED=true
# AI聊天功能开关 (默认开启)
AI_CHAT_ENABLED=true
