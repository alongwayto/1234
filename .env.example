DB_USERNAME=root
DB_PASSWORD=
DB_URL=jdbc:mysql://127.0.0.1:3307/campus_equipment?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false
BACKUP_PATH=./backups/
MYSQL_DUMP_PATH=mysqldump
MYSQL_PATH=mysql

# ============================================
# AI 智能模块配置 (免费开源模型推荐使用 Ollama)
# ============================================

# AI 运行模式: ollama(免费本地模型) | volcengine(云端豆包) | mock(模拟数据)
AI_MODE=ollama

# Ollama 本地模型 (mode=ollama时使用，完全免费)
# 推荐模型: qwen2.5:3b, llama3.2, mistral, deepseek-r1:1.5b
AI_MODEL=qwen2.5:3b

# Ollama API地址 (可选，默认 http://localhost:11434/api/chat)
# AI_API_URL=http://localhost:11434/api/chat

# 火山引擎API Key (mode=volcengine时需要，可选)
# AI_API_KEY=your_api_key_here

# ============================================
# 原有的豆包配置 (可选，mode=volcengine时使用)
# ============================================
# DOUBAO_API_KEY=your_doubao_api_key

# AI诊断功能开关 (默认开启)
AI_DIAGNOSIS_ENABLED=true
# AI聊天功能开关 (默认开启)
AI_CHAT_ENABLED=true
